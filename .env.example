# ============================================================================
# MTMF local PostgreSQL development configuration (placeholders only).
#
# These are DEVELOPMENT PLACEHOLDERS, not real secrets. Never commit real
# credentials here. Copy this file to `.env` when needed, or export the
# variables in your shell.
#
# MTMF tooling (scripts, migration helpers, integration tests) reads MTMF_*
# configuration explicitly and FAILS CLOSED when it is missing, malformed,
# or ambiguous. It never probes for, discovers, or falls back to another
# PostgreSQL instance — including any ATI-owned database.
# ============================================================================

# Canonical MTMF Compose project. MTMF scripts always pass
# `--project-name mtmf` explicitly; this variable is informational and
# must never redirect an MTMF cleanup/reset operation toward another
# project (MTMF scripts refuse to run when this differs from "mtmf").
COMPOSE_PROJECT_NAME=mtmf

# MTMF PostgreSQL service connection. The container-internal port is 5432;
# the host-published port is configurable and defaults to 25432, following
# the MTMF host-port prefix-2 convention (the port number alone is never
# treated as proof of MTMF ownership).
MTMF_POSTGRES_HOST=127.0.0.1
MTMF_POSTGRES_PORT=25432
MTMF_POSTGRES_DB=mtmf
MTMF_POSTGRES_USER=mtmf
MTMF_POSTGRES_PASSWORD=mtmf-dev-password

# Alternative to the MTMF_POSTGRES_* variables: a full connection URL.
# If MTMF_DATABASE_URL is set, the MTMF_POSTGRES_* variables must not be
# set (both at once is treated as ambiguous configuration and fails closed).
# MTMF_DATABASE_URL=postgresql+psycopg://mtmf:mtmf-dev-password@127.0.0.1:25432/mtmf

# ----------------------------------------------------------------------------
# Deployment (migration) identity: MTMF_MIGRATOR_*.
#
# Created by `scripts/mtmf-provision-roles.py`; may SET ROLE mtmf_owner for
# controlled migrations only. Never used by application runtime code.
# ----------------------------------------------------------------------------
MTMF_MIGRATOR_POSTGRES_HOST=127.0.0.1
MTMF_MIGRATOR_POSTGRES_PORT=25432
MTMF_MIGRATOR_POSTGRES_DB=mtmf
MTMF_MIGRATOR_POSTGRES_USER=mtmf_migrator
MTMF_MIGRATOR_POSTGRES_PASSWORD=mtmf-migrator-dev-password
# MTMF_MIGRATOR_DATABASE_URL=postgresql+psycopg://mtmf_migrator:mtmf-migrator-dev-password@127.0.0.1:25432/mtmf

# ----------------------------------------------------------------------------
# Restricted application (runtime) identity: MTMF_RUNTIME_*.
#
# No ownership, no schema CREATE, no table/sequence DML, and EXECUTE only on
# explicitly approved MTMF functions. Migration management rejects this role.
# ----------------------------------------------------------------------------
MTMF_RUNTIME_POSTGRES_HOST=127.0.0.1
MTMF_RUNTIME_POSTGRES_PORT=25432
MTMF_RUNTIME_POSTGRES_DB=mtmf
MTMF_RUNTIME_POSTGRES_USER=mtmf_runtime
MTMF_RUNTIME_POSTGRES_PASSWORD=mtmf-runtime-dev-password
# Restricted-runtime PostgreSQL session timeouts (applied to every
# runtime connection; lock must be shorter than statement, and the
# statement timeout must be shorter than the HTTP evaluation deadline).
MTMF_RUNTIME_STATEMENT_TIMEOUT_MS=10000
MTMF_RUNTIME_LOCK_TIMEOUT_MS=3000
# MTMF_RUNTIME_DATABASE_URL=postgresql+psycopg://mtmf_runtime:mtmf-runtime-dev-password@127.0.0.1:25432/mtmf
# ----------------------------------------------------------------------------
# PR 17 authenticated HTTP authorization service (DEVELOPMENT ONLY).
#
# The production profile is disabled until the production issuer trust and
# root authentication/recovery release gates are approved. No real secret is
# committed here; copy this file to `.env`, generate secrets, and never commit
# `.env`. The HTTP service environment must NOT contain migrator/owner or
# bootstrap-admin credentials.
# ----------------------------------------------------------------------------
MTMF_SERVICE_DEPLOYMENT_MODE=development
MTMF_SERVICE_HOST=127.0.0.1
MTMF_SERVICE_PORT=28001
# Set to 1 only for the loopback-published development container.
MTMF_SERVICE_ALLOW_CONTAINER_BIND=0
MTMF_SERVICE_MAX_REQUEST_BYTES=65536
MTMF_SERVICE_DEFAULT_TTL_SECONDS=60
MTMF_SERVICE_MAX_TTL_SECONDS=300
MTMF_SERVICE_SENSITIVE_TTL_SECONDS=15
MTMF_SERVICE_RATE_LIMIT_PER_MINUTE=600
MTMF_SERVICE_RATE_LIMIT_BURST=60
# Hard cap on concurrent synchronous evaluations; permits are held
# until the underlying worker completes (not just the HTTP deadline).
MTMF_SERVICE_MAX_IN_FLIGHT_EVALUATIONS=40

# PR 14 development issuer trust (distinct service/user audiences required;
# the shared-audience development profile must be explicitly enabled).
MTMF_AUTH_ISSUER=https://127.0.0.1:28443/realms/mtmf-pr14-dev
MTMF_AUTH_SERVICE_AUDIENCE=mtmf-service-api
MTMF_AUTH_USER_AUDIENCE=mtmf-user-api
MTMF_AUTH_JWKS_URI=https://127.0.0.1:28443/realms/mtmf-pr14-dev/protocol/openid-connect/certs
MTMF_AUTH_EXPECTED_MANIFEST=dev/keycloak/expected-realm-security.json
MTMF_AUTH_EXPECTED_CLIENT_POLICY=dev/keycloak/expected-client-policy.json
MTMF_AUTH_ADMIN_BASE=https://127.0.0.1:28443
MTMF_AUTH_ADMIN_REALM=mtmf-pr14-dev
# Dedicated least-privilege attestation reader (client credentials, read-only
# realm roles: view-realm/view-clients/query-clients). The runtime never
# receives a human/admin password. Prefer the _FILE form (Podman secret).
MTMF_AUTH_ATTESTATION_CLIENT_ID=mtmf-attestation-reader
MTMF_AUTH_ATTESTATION_CLIENT_SECRET=mtmf-attestation-reader-dev-secret
# MTMF_AUTH_ATTESTATION_CLIENT_SECRET_FILE=/run/secrets/mtmf-attestation-reader

# Keycloak Admin REST bootstrap credential, used ONLY by the privileged
# one-shot initializer. It must NEVER be present in the HTTP runtime.
MTMF_AUTH_ADMIN_USERNAME=mtmf-pr14-admin
MTMF_AUTH_ADMIN_PASSWORD=change-me-keycloak-admin

# Development initializer fixture (application-neutral; no product names).
MTMF_DEV_TENANT_KEY=dev
MTMF_DEV_TENANT_NAME=Development Tenant
MTMF_DEV_USER_SUBJECT=mtmf-dev-user
MTMF_DEV_APPLICATION_KEYS=sample-app

# Keycloak bootstrap admin, used ONLY by the one-shot initializer.
MTMF_PR14_KC_ADMIN_USERNAME=mtmf-pr14-admin
MTMF_PR14_KC_ADMIN_PASSWORD=change-me-keycloak-admin
MTMF_PR14_KC_HTTP_PORT=28080
MTMF_PR14_KC_HTTPS_PORT=28443
MTMF_PR14_KC_TLS_DIR=/tmp/mtmf-pr14-kc-tls
