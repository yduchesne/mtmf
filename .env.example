# ============================================================================
# MTMF local PostgreSQL development configuration (placeholders only).
#
# These are DEVELOPMENT PLACEHOLDERS, not real secrets. Never commit real
# credentials here. Copy this file to `.env` when needed, or export the
# variables in your shell.
#
# MTMF tooling (scripts, migration helpers, integration tests) reads MTMF_*
# configuration explicitly and FAILS CLOSED when it is missing, malformed,
# or ambiguous. It never probes for, discovers, or falls back to another
# PostgreSQL instance — including any ATI-owned database.
# ============================================================================

# Canonical MTMF Compose project. MTMF scripts always pass
# `--project-name mtmf` explicitly; this variable is informational and
# must never redirect an MTMF cleanup/reset operation toward another
# project (MTMF scripts refuse to run when this differs from "mtmf").
COMPOSE_PROJECT_NAME=mtmf

# MTMF PostgreSQL service connection. The container-internal port is 5432;
# the host-published port is configurable and defaults to 55432 (checked
# free on the current repository host; the port number alone is never
# treated as proof of MTMF ownership).
MTMF_POSTGRES_HOST=127.0.0.1
MTMF_POSTGRES_PORT=55432
MTMF_POSTGRES_DB=mtmf
MTMF_POSTGRES_USER=mtmf
MTMF_POSTGRES_PASSWORD=mtmf-dev-password

# Alternative to the MTMF_POSTGRES_* variables: a full connection URL.
# If MTMF_DATABASE_URL is set, the MTMF_POSTGRES_* variables must not be
# set (both at once is treated as ambiguous configuration and fails closed).
# MTMF_DATABASE_URL=postgresql+psycopg://mtmf:mtmf-dev-password@127.0.0.1:55432/mtmf