# ============================================================================
# MTMF local PostgreSQL development configuration (placeholders only).
#
# These are DEVELOPMENT PLACEHOLDERS, not real secrets. Never commit real
# credentials here. Copy this file to `.env` when needed, or export the
# variables in your shell.
#
# MTMF tooling (scripts, migration helpers, integration tests) reads MTMF_*
# configuration explicitly and FAILS CLOSED when it is missing, malformed,
# or ambiguous. It never probes for, discovers, or falls back to another
# PostgreSQL instance — including any ATI-owned database.
# ============================================================================

# Canonical MTMF Compose project. MTMF scripts always pass
# `--project-name mtmf` explicitly; this variable is informational and
# must never redirect an MTMF cleanup/reset operation toward another
# project (MTMF scripts refuse to run when this differs from "mtmf").
COMPOSE_PROJECT_NAME=mtmf

# MTMF PostgreSQL service connection. The container-internal port is 5432;
# the host-published port is configurable and defaults to 25432, following
# the MTMF host-port prefix-2 convention (the port number alone is never
# treated as proof of MTMF ownership).
MTMF_POSTGRES_HOST=127.0.0.1
MTMF_POSTGRES_PORT=25432
MTMF_POSTGRES_DB=mtmf
MTMF_POSTGRES_USER=mtmf
MTMF_POSTGRES_PASSWORD=mtmf-dev-password

# Alternative to the MTMF_POSTGRES_* variables: a full connection URL.
# If MTMF_DATABASE_URL is set, the MTMF_POSTGRES_* variables must not be
# set (both at once is treated as ambiguous configuration and fails closed).
# MTMF_DATABASE_URL=postgresql+psycopg://mtmf:mtmf-dev-password@127.0.0.1:25432/mtmf

# ----------------------------------------------------------------------------
# Deployment (migration) identity: MTMF_MIGRATOR_*.
#
# Created by `scripts/mtmf-provision-roles.py`; may SET ROLE mtmf_owner for
# controlled migrations only. Never used by application runtime code.
# ----------------------------------------------------------------------------
MTMF_MIGRATOR_POSTGRES_HOST=127.0.0.1
MTMF_MIGRATOR_POSTGRES_PORT=25432
MTMF_MIGRATOR_POSTGRES_DB=mtmf
MTMF_MIGRATOR_POSTGRES_USER=mtmf_migrator
MTMF_MIGRATOR_POSTGRES_PASSWORD=mtmf-migrator-dev-password
# MTMF_MIGRATOR_DATABASE_URL=postgresql+psycopg://mtmf_migrator:mtmf-migrator-dev-password@127.0.0.1:25432/mtmf

# ----------------------------------------------------------------------------
# Restricted application (runtime) identity: MTMF_RUNTIME_*.
#
# No ownership, no schema CREATE, no table/sequence DML, and EXECUTE only on
# explicitly approved MTMF functions. Migration management rejects this role.
# ----------------------------------------------------------------------------
MTMF_RUNTIME_POSTGRES_HOST=127.0.0.1
MTMF_RUNTIME_POSTGRES_PORT=25432
MTMF_RUNTIME_POSTGRES_DB=mtmf
MTMF_RUNTIME_POSTGRES_USER=mtmf_runtime
MTMF_RUNTIME_POSTGRES_PASSWORD=mtmf-runtime-dev-password
# MTMF_RUNTIME_DATABASE_URL=postgresql+psycopg://mtmf_runtime:mtmf-runtime-dev-password@127.0.0.1:25432/mtmf